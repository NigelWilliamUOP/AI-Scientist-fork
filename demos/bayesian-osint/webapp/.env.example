# Copy to .env for local use. Never commit .env or paste keys in a GitHub issue.
APP_ENV=local
APP_PUBLIC_URL=http://127.0.0.1:8000
# Omit APP_OWNER_PASSWORD locally to generate a private access password.
# APP_OWNER_PASSWORD=at-least-16-characters
# APP_REVIEWER_PASSWORD=a-different-long-password
# Production: use HTTPS and the hosting provider's encrypted secret store.
# APP_DATA_DIR=/data
# AI is deliberately disabled until all of these are explicitly set.
AI_PROVIDER=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_PROVIDERS=
ALLOW_PAID_AI=false
AI_SESSION_BUDGET_USD=5
AI_DAILY_BUDGET_USD=20
AI_CALL_CEILING_USD=0.25
# Owner OAuth: authorised redirect must match APP_PUBLIC_URL plus
# /api/v1/owner/drive/callback . This app requests only drive.file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
