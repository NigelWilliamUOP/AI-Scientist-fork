# Copy to .github/workflows/osint-webapp.yml when ready to enable CI.
name: OSINT web app
on:
  workflow_dispatch:
  pull_request:
    paths: ['demos/bayesian-osint/webapp/**']
permissions:
  contents: read
jobs:
  check:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: demos/bayesian-osint/webapp
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.13'
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - run: pip install -r requirements-dev.txt
      - run: npm ci --ignore-scripts && npm run build
        working-directory: demos/bayesian-osint/webapp/frontend
      - run: PYTHONPATH=backend pytest -q backend/tests
      - run: docker build -t osint-bayes-ci .
# This does not provision hosting or call paid AI providers.
